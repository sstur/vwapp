{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "channel": "main",
      "autoIncrement": true,
      "environment": "production"
    },
    "simulator": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "$ASC_APP_ID"
      }
    }
  }
}
