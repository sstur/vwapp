{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vwapp-api",
  // No account_id pinned here so anyone can deploy to their own account: set
  // CLOUDFLARE_ACCOUNT_ID in the environment before `wrangler deploy` (wrangler
  // reads it natively). Each deployer gets vwapp-api.<their-subdomain>.workers.dev.
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "VEHICLE_PROVIDER": "android" },
  "durable_objects": {
    "bindings": [{ "name": "ANDROID_GATEWAY", "class_name": "AndroidGateway" }],
  },
  "migrations": [
    { "tag": "android-gateway-v1", "new_sqlite_classes": ["AndroidGateway"] },
  ],
  "observability": { "enabled": true },
  // Workers AI powers the voice assistant (STT + GLM-5.2 LLM + TTS), reached via
  // env.AI. No key: it bills to the deploy account, which must have Workers AI
  // enabled. In dev, `wrangler dev` proxies these calls to the real Workers AI.
  "ai": { "binding": "AI" },
  // One-minute ticks maintain requested climate sessions. Android status reads
  // run every fifth tick and yield to interactive phone work. Alarms, not cron
  // invocations, finish admitted jobs after disconnects.
  "env": {
    "integration": {
      "name": "vwapp-api-integration",
      "vars": { "VEHICLE_PROVIDER": "android" },
      "durable_objects": {
        "bindings": [
          { "name": "ANDROID_GATEWAY", "class_name": "AndroidGateway" },
        ],
      },
      "triggers": { "crons": [] },
    },
  },
  "triggers": { "crons": ["* * * * *"] },
}
